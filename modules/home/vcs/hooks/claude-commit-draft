#!/usr/bin/env bash
# Print a Claude Code commit-message draft for the diff on stdin.
# On failure, exit non-zero and print the reason on stdout or stderr.

set -u

prompt=$(
	cat <<EOF
  Write a commit message for the attached diff.

  Return only the commit message as plain text.

  Follow Conventional Commits spec. Make sure the subject line is no longer than
  72 characters.

  Make sure the body text has no lines longer than 80 characters. Insert
  newlines as needed.

  Do not use Markdown fences, headings, trailers, or validation results.

  Do not modify any files. Only use the attached diff.
EOF
)

if ! command -v claude >/dev/null 2>&1; then
	printf '%s\n' 'claude is not on PATH; skipped.'
	exit 127
fi

exec claude --print \
	--agent write-commit-msg \
	--output-format text \
	--permission-mode dontAsk \
	--permission-prompts none \
	--tools "" \
	--disallowed-tools "mcp__*" \
	--no-session-persistence \
	"${prompt}"
