#!/usr/bin/env bash
# Generate draft commit messages with Claude Code for Git and Jujutsu.
# Failures leave the normal editor flow untouched.

set -u

message_file=$1
source=${2:-}
vcs=${3:-git}

if [ "$vcs" = git ]; then
	case "$source" in
	message | template | merge | squash | commit)
		exit 0
		;;
	esac
elif [ "$vcs" = jj ]; then
	if ! grep -q '^JJ: ignore-rest$' "$message_file"; then
		exit 0
	fi

	if sed '/^JJ: ignore-rest$/,$d; /^JJ:/d; /^[[:space:]]*$/d' "$message_file" |
		grep -q '[^[:space:]]'; then
		exit 0
	fi
else
	exit 0
fi

# Explain a missing draft on stderr and as a comment in the editor buffer,
# where it stays visible after the editor clears the terminal.
report() {
	printf 'Claude Code commit draft: %s\n' "$1" >&2
	if [ "$vcs" = git ]; then
		comment_prefix='#'
	else
		comment_prefix='JJ:'
	fi
	{
		printf '%s Claude Code commit draft: %s\n' "$comment_prefix" "$1"
		cat "$message_file"
	} >"$message_file.claude-report" &&
		mv "$message_file.claude-report" "$message_file"
}

tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/claude-commit.XXXXXX") || exit 0
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM

diff_file=$tmp_dir/commit.diff
output_file=$tmp_dir/message

if [ "$vcs" = git ]; then
	git diff --cached --quiet && exit 0
	git diff --cached --no-ext-diff >"$diff_file" || exit 0
else
	sed '1,/^JJ: ignore-rest$/d' "$message_file" >"$diff_file"
	[ -s "$diff_file" ] || exit 0
fi

printf '%s\n' 'Generating commit-message draft with Claude Code...' >&2

@claudeCommitDraft@ <"${diff_file}" >"${output_file}"
claude_status=$?

if [ "$claude_status" -ne 0 ]; then
	# claude --print reports failures such as "Not logged in" on stdout.
	reason=$(tr '\n' ' ' <"$output_file" | sed 's/ *$//' | cut -c 1-200)
	report "failed (exit $claude_status): ${reason:-no output}"
	exit 0
fi

if [ ! -s "$output_file" ]; then
	report 'claude returned an empty message.'
	exit 0
fi

if [ "$vcs" = git ]; then
	cp "$output_file" "$message_file"
else
	combined_file=$tmp_dir/combined-message
	{
		cat "$output_file"
		printf '\n'
		cat "$message_file"
	} >"$combined_file"
	cp "$combined_file" "$message_file"
fi
