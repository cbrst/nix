{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.programs.nixie;
in
{
  options.programs.nixie.flake = lib.mkOption {
    type = lib.types.nullOr lib.types.str;
    default = null;
    example = lib.literalExpression ''"''${config.home.homeDirectory}/Projects/nix"'';
    description = ''
      Path of the flake checkout nixie manages, written to
      {file}`$XDG_CONFIG_HOME/nixie/config`. The `NIXIE_FLAKE` environment
      variable overrides it. When null, no configuration file is written.
    '';
  };

  config = {
    # Day-to-day flake management: update, rebuild, diff, clean, roll back.
    home.packages = [ (pkgs.callPackage ../../packages/nixie { }) ];

    xdg.configFile."nixie/config" = lib.mkIf (cfg.flake != null) {
      text = ''
        # Generated by Home Manager from programs.nixie.
        flake = ${cfg.flake}
      '';
    };
  };
}
