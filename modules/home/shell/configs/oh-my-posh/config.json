{
	"$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
	"version": 4,
	"final_space": false,
	"shell_integration": true,
	"transient_prompt": {
		"foreground": "yellow",
		"template": "{{ .PWD }} ",
		"filler": "─",
		"newline": true
	},
	"palettes": {
		"template": "{{ if eq .Env.POSH_COLOR_MODE \"light\" }}light{{ else }}dark{{ end }}",
		"list": {
			"light": {
				"path": "@light-path@",
				"vcs": "@light-vcs@"
			},
			"dark": {
				"path": "@dark-path@",
				"vcs": "@dark-vcs@"
			}
		}
	},
	"blocks": [
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"type": "session",
					"style": "powerline",
					"leading_powerline_symbol": "",
					"powerline_symbol": "",
					"background": "green",
					"foreground": "black",
					"template": "{{ .UserName }}"
				},
				{
					"type": "path",
					"style": "powerline",
					"powerline_symbol": "",
					"background": "p:path",
					"foreground": "default",
					"template": " {{ .Path }}",
					"options": {
						"style": "powerlevel",
						"right_format": "<b>%s</b>",
						"home_icon": " ",
						"display_root": true
					}
				},
				{
					"type": "git",
					"style": "powerline",
					"powerline_symbol": "",
					"background": "p:vcs",
					"foreground": "default",
					"template": "  {{ .Ref }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}",
					"options": {
						"disable_with_jj": true
					}
				},
				{
					"type": "jujutsu",
					"style": "powerline",
					"powerline_symbol": "",
					"background": "p:vcs",
					"foreground": "default",
					"template": "  {{ .ClosestBookmarks }}@<b>{{ .ChangeIDPrefix }}</b>{{ .ChangeIDRest }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}",
					"options": {
						"change_id_min_len": 6,
						"fetch_status": true
					}
				}
			]
		},
		{
			"type": "prompt",
			"alignment": "left",
			"segments": [
				{
					"type": "text",
					"style": "plain",
					"template": "\n 󱞩 "
				}
			]
		},
		{
			"type": "rprompt",
			"alignment": "right",
			"segments": [
				{
					"type": "node",
					"style": "plain",
					"foreground": "green",
					"template": " 󰎙 {{ .Full }} "
				},
				{
					"type": "python",
					"style": "plain",
					"foreground": "red",
					"template": " 󰌠 {{ .Full }} "
				}
			]
		}
	]
}
